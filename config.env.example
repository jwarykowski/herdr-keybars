# herdr-keybars settings: copy to
# `$(herdr plugin config-dir jwarykowski.herdr-keybars)/config.env`
# and keep only what you change. Run the restart action afterwards.

# colours (keybars-pro's names or #rrggbb) and effects: flash, pulse, wave,
# fade, sparkle, ripple (once), or hold, breathe, chase (until it changes)
HERDR_KEYBARS_BLOCKED=amber
HERDR_KEYBARS_BLOCKED_EFFECT=breathe
HERDR_KEYBARS_DONE=green
HERDR_KEYBARS_DONE_EFFECT=hold

# the key that shows any agent is blocked; bind it to next-agent
HERDR_KEYBARS_JUMP=top-right

# workspace keys 1-9 by position, as keybars-pro light names them; empty picks
# the number row for a Moonlander or a Voyager. keybars-pro map shows yours.
# HERDR_KEYBARS_KEYS="r1c2 r1c3 r1c4 r1c5 r1c6 r1c7 r1c8 r1c9 r1c10"

# also send agent.waiting / agent.done to keybars Pro's rules, with -repo set
# to the workspace's label; 0 for lights only
HERDR_KEYBARS_EVENTS=1

# failing CI from herdr-gh (through the bridge) on the workspace's key, when
# no agent state is showing there; 0 for off
HERDR_KEYBARS_CI_KEYS=1
HERDR_KEYBARS_CI=red
HERDR_KEYBARS_CI_EFFECT=hold

# keybars Pro's Focus timer as a sidebar token: add $focus to
# [ui.sidebar.spaces]; empty for none
HERDR_KEYBARS_FOCUS_TOKEN=focus

# herdr-pomodoro, when bridged: focus starts and stops keybars Pro's Focus
# with it (one timer); events sends focus.started, .break, .done and
# .stopped to Notify for your own rules; off ignores it
HERDR_KEYBARS_POMODORO=focus

# seconds between polls of herdr
HERDR_KEYBARS_INTERVAL=1

# the keybars Pro command, if it isn't on herdr's PATH
# HERDR_KEYBARS_COMMAND=/usr/local/bin/keybars-pro
