#!/usr/bin/env bash
# herdr-keybars bridge: herdr-gh's and herdr-pomodoro's hooks, into keybars
# Pro. setup links it into each plugin's hooks/ under the event's name. Both
# plugins name their events as keybars Pro does, so they pass straight on.
#   herdr-gh        ci.*, review.*, pull_request.*  ->  keybars-pro notify
#                   -source github, with the repo and branch, so GitHub rules
#                   play them; failing CI also marks the workspace, so the
#                   watcher holds its number key red
#   herdr-pomodoro  focus.*  ->  keybars Pro's Focus timer (one timer, not
#                   two), or notify events for your own rules
set -uo pipefail

PATH="$PATH:$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin"

kp="${HERDR_KEYBARS_COMMAND:-keybars-pro}"
state_dir="${HERDR_KEYBARS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-keybars}"
config_dir="${HERDR_KEYBARS_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr-keybars}"

# focus: a pomodoro starts and stops keybars Pro's Focus; events: send
# focus.started and the rest to Notify; off: nothing
: "${HERDR_KEYBARS_POMODORO:=focus}"
# shellcheck source=/dev/null
[[ -f "$config_dir/config.env" ]] && source "$config_dir/config.env"

command -v "$kp" >/dev/null 2>&1 || exit 0

event="${HERDR_GH_EVENT:-${HERDR_POMODORO_EVENT:-$(basename "$0")}}"

# ci marks a workspace's CI as failing for the watcher, or clears it
ci() {
  local ws=${HERDR_GH_WORKSPACE_ID:-}
  [[ -n $ws && $ws != */* ]] || return 0
  mkdir -p "$state_dir/ci"
  if [[ $1 == failed ]]; then
    echo "${HERDR_GH_REPO:-}" >"$state_dir/ci/$ws"
  else
    rm -f "$state_dir/ci/$ws"
  fi
}

gh() {
  case $1 in
    ci.failed) ci failed ;;
    ci.passed | pull_request.merged | pull_request.closed) ci clear ;;
  esac
  "$kp" notify -q -source github -repo "${HERDR_GH_REPO:-}" -branch "${HERDR_GH_BRANCH:-}" "$1"
}

pomodoro() {
  case $HERDR_KEYBARS_POMODORO in
    off) return 0 ;;
    events)
      "$kp" notify -q "$1"
      return
      ;;
  esac
  case $1 in
    focus.started)
      # the round's length, from when it ends
      local ends=${HERDR_POMODORO_ENDS_AT:-} mins=""
      if [[ $ends =~ ^[0-9]+$ ]]; then
        mins=$(((ends - $(date +%s) + 59) / 60))
        ((mins > 0)) || mins=""
      fi
      "$kp" focus start ${mins:+"${mins}m"} >/dev/null 2>&1
      ;;
    focus.stopped) "$kp" focus stop >/dev/null 2>&1 ;;
  esac
}

case $event in
  ci.* | review.* | pull_request.*) gh "$event" ;;
  focus.*) pomodoro "$event" ;;
esac
exit 0
