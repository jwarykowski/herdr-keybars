#!/usr/bin/env bash
# herdr-keybars focus: keybars Pro's Focus timer, from herdr. The watcher
# shows it in the sidebar as $focus and says when breaks start and end.
#
# usage: focus [toggle]   start it, or stop it if it's running
#        focus start [25m] | stop
set -uo pipefail

# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/herdr.sh
source "$(cd "$(dirname "$0")/.." && pwd)/lib/herdr.sh"

if ! phase=$("$kp" focus status -json 2>/dev/null | jq -r '.phase // ""'); then
  notify "keybars Pro isn't running"
  exit 0
fi
action=${1:-toggle}
if [[ $action == toggle ]]; then
  action=start
  [[ -n $phase ]] && action=stop
fi
case $action in
  start) "$kp" focus start ${2:+"$2"} >/dev/null 2>&1 && notify "Focus started" ;;
  stop) "$kp" focus stop >/dev/null 2>&1 && notify "Focus stopped" ;;
  *)
    echo "usage: focus [toggle | start [25m] | stop]" >&2
    exit 1
    ;;
esac
exit 0
