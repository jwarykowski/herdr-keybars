#!/usr/bin/env bash
# focus the herdr agent that needs you: blocked first, then done. agents other
# than the focused one come first, so repeated presses walk through every
# waiting agent.
set -euo pipefail

# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/herdr.sh
source "$(cd "$(dirname "$0")/.." && pwd)/lib/herdr.sh"

target=$("$herdr" agent list | jq -r '
  .result.agents
  | map(select(.agent_status == "blocked" or .agent_status == "done"))
  | sort_by(if .agent_status == "blocked" then 0 else 1 end)
  | map(select(.focused | not)) + map(select(.focused))
  | .[0].pane_id // empty')

if [[ -z "$target" ]]; then
  notify "no agents waiting"
  exit 0
fi
"$herdr" agent focus "$target" >/dev/null
