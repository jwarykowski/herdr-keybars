#!/usr/bin/env bash
# herdr-keybars: herdr's agents on the keyboard, through keybars Pro's
# keybars-pro command:
#   number key N  workspace N (as ctrl+alt+N): breathing while its agent is
#                 blocked on you, held while it's done
#   top-right     breathing while any agent is blocked (next-agent jumps there)
#   number key N  also held red while workspace N's CI fails, as bin/github
#                 sees it, when no agent state is showing
#   $focus        keybars Pro's Focus timer in herdr's sidebar: 🎯12m, ☕3m,
#                 with a notification when a break starts and ends
# Lights play over keybars Pro's music, and only what changes is sent.
#
# usage: watch start    spawn the watcher in the background (startup hook)
#        watch stop     stop it, clearing its lights
#        watch run      watch in the foreground until herdr goes away
#        watch toggle   agent lights off / on
#        watch keyboard keybars Pro's lights off / on (its header switch)
set -uo pipefail

# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/herdr.sh
source "$(cd "$(dirname "$0")/.." && pwd)/lib/herdr.sh"
disabled="$state_dir/disabled"

# defaults, unless the environment sets them; config.env overrides either
: "${HERDR_KEYBARS_BLOCKED:=amber}"
: "${HERDR_KEYBARS_BLOCKED_EFFECT:=breathe}"
: "${HERDR_KEYBARS_DONE:=green}"
: "${HERDR_KEYBARS_DONE_EFFECT:=hold}"
: "${HERDR_KEYBARS_JUMP:=top-right}"
: "${HERDR_KEYBARS_INTERVAL:=1}"
# also send agent.waiting / agent.done events, with -repo the workspace's
# label, so your own Notify rules can react
: "${HERDR_KEYBARS_EVENTS:=1}"
# workspace keys 1-9 by position; empty picks them for the keyboard
: "${HERDR_KEYBARS_KEYS:=}"
# failing CI on the workspace's key, from bin/github
: "${HERDR_KEYBARS_CI_KEYS:=1}"
: "${HERDR_KEYBARS_CI:=red}"
: "${HERDR_KEYBARS_CI_EFFECT:=hold}"
# the sidebar token for keybars Pro's Focus timer; empty for none
: "${HERDR_KEYBARS_FOCUS_TOKEN:=focus}"
load_config

# keys is the workspace keys 1-9: the number row, which sits differently on
# each board
keys() {
  if [[ -n "$HERDR_KEYBARS_KEYS" ]]; then
    echo "$HERDR_KEYBARS_KEYS"
    return
  fi
  local board
  board=$("$kp" status -json 2>/dev/null | jq -r '.keyboard // ""' | tr '[:upper:]' '[:lower:]')
  case $board in
    *moonlander*) echo "r1c2 r1c3 r1c4 r1c5 r1c6 r1c9 r1c10 r1c11 r1c12" ;;
    *) echo "r1c2 r1c3 r1c4 r1c5 r1c6 r1c7 r1c8 r1c9 r1c10" ;; # Voyager and most 12-column boards
  esac
}

# failing is the workspace IDs whose CI is failing, as a JSON array
failing() {
  local f ids=()
  if ((HERDR_KEYBARS_CI_KEYS)); then
    for f in "$state_dir"/ci/*; do
      [[ -e $f ]] && ids+=("${f##*/}")
    done
  fi
  ((${#ids[@]})) || {
    echo '[]'
    return
  }
  printf '%s\n' "${ids[@]}" | jq -R . | jq -s .
}

# frame is "key state label" for each lit key, from herdr's workspaces; fails
# when herdr isn't reachable. An agent's state wins over failing CI.
frame() {
  local workspaces
  workspaces=$("$herdr" workspace list 2>/dev/null) || return 1
  jq -r --argjson keys "$(tr ' ' '\n' <<<"$1" | jq -R . | jq -s .)" --arg jump "$HERDR_KEYBARS_JUMP" \
    --argjson failing "$(failing)" '
    .result.workspaces
    | (map(select(.number >= 1 and .number <= ($keys | length))
           | (if .agent_status == "blocked" or .agent_status == "done" then .agent_status
              elif (.workspace_id as $w | $failing | index($w)) then "ci"
              else empty end) as $state
           | "\($keys[.number - 1]) \($state) \(.label // .number | tostring | gsub(" "; "-"))")
       + (if any(.agent_status == "blocked") then ["\($jump) blocked -"] else [] end))
    | .[]' <<<"$workspaces"
}

light() {
  local key=$1 state=$2
  case $state in
    blocked) "$kp" light "$key" "$HERDR_KEYBARS_BLOCKED" -effect "$HERDR_KEYBARS_BLOCKED_EFFECT" >/dev/null 2>&1 ;;
    ci) "$kp" light "$key" "$HERDR_KEYBARS_CI" -effect "$HERDR_KEYBARS_CI_EFFECT" >/dev/null 2>&1 ;;
    *) "$kp" light "$key" "$HERDR_KEYBARS_DONE" -effect "$HERDR_KEYBARS_DONE_EFFECT" >/dev/null 2>&1 ;;
  esac
}

event() {
  local state=$1 label=$2
  ((HERDR_KEYBARS_EVENTS)) && [[ $label != - ]] || return 0
  case $state in
    blocked) "$kp" notify -q -repo "$label" agent waiting ;;
    done) "$kp" notify -q -repo "$label" agent "done" ;;
  esac
}

# apply sends what changed between two frames: lights for new or changed
# keys, events for workspaces whose state changed, and clears for keys gone
apply() {
  local now=$1 before=$2 key state label old
  declare -A was=()
  while read -r key state label; do
    [[ -n $key ]] && was[$key]="$state $label"
  done <<<"$before"
  declare -A seen=()
  while read -r key state label; do
    [[ -n $key ]] || continue
    seen[$key]=1
    old=${was[$key]:-}
    [[ $old == "$state $label" ]] && continue
    light "$key" "$state" || return 1
    event "$state" "$label"
  done <<<"$now"
  for key in "${!was[@]}"; do
    [[ -n ${seen[$key]:-} ]] || "$kp" clear "$key" >/dev/null 2>&1 || return 1
  done
}

# clear_all takes every light this watcher made off the board
clear_all() {
  local key
  for key in $1 $HERDR_KEYBARS_JUMP; do
    "$kp" clear "$key" >/dev/null 2>&1
  done
  return 0
}

# focus_state is keybars Pro's Focus timer as "phase minutes-left", or
# nothing when it isn't running
focus_state() {
  "$kp" focus status -json 2>/dev/null |
    jq -r 'if .phase == "work" or .phase == "break" then "\(.phase) \((.remaining / 60) | ceil)" else "" end' 2>/dev/null
}

# focus_token is the sidebar token for a focus_state: 🎯12m, ☕3m
focus_token() {
  case ${1%% *} in
    work) echo "🎯${1##* }m" ;;
    break) echo "☕${1##* }m" ;;
  esac
}

# focus_changed tells you when a break starts and ends, as the timer itself
# only shows on the keyboard
focus_changed() {
  local from=${1%% *} to=${2%% *}
  [[ $from == "$to" ]] && return 0
  if [[ $to == break ]]; then
    notify "Focus: time for a break (${2##* } minutes)"
  elif [[ $from == break ]]; then
    notify "Focus: break over"
  fi
}

run() {
  local last="" current misses=0 ks focus="" focus_was="" reported=0
  claim watch
  if ! have_keybars; then
    notify "herdr-keybars needs keybars Pro's keybars-pro command: App settings, Install the command-line tool"
    rm -f "$state_dir/watch.pid"
    return 1
  fi
  ks=$(keys)
  trap 'clear_all "$ks"; rm -f "$state_dir/watch.pid"; exit 0' INT TERM
  # exit once herdr has been unreachable for a few polls (server stopped);
  # the startup hook spawns a fresh watcher with the next session
  while ((misses < 5)); do
    if [[ -f "$disabled" ]]; then
      current="" misses=0
    elif current=$(frame "$ks"); then
      misses=0
    else
      current="" misses=$((misses + 1))
    fi
    # send only on change; a failed send (app closed) retries next tick
    if [[ "$current" != "$last" ]]; then
      apply "$current" "$last" && last="$current"
    fi
    # Focus: a notification as breaks start and end, and the token on
    # change and each minute, so it doesn't expire
    focus=$(focus_state)
    focus_changed "$focus_was" "$focus"
    if [[ -n $HERDR_KEYBARS_FOCUS_TOKEN ]] &&
      { [[ $focus != "$focus_was" ]] || { [[ -n $focus ]] && ((SECONDS - reported >= 60)); }; }; then
      token_all "$HERDR_KEYBARS_FOCUS_TOKEN" "$(focus_token "$focus")" 90000
      reported=$SECONDS
    fi
    focus_was=$focus
    # background sleep + wait, so stop's TERM lands immediately
    sleep "$HERDR_KEYBARS_INTERVAL" &
    wait $!
  done
  clear_all "$ks"
  rm -f "$state_dir/watch.pid"
}

case "${1:-}" in
  start) spawn watch ;;
  stop) halt watch ;;
  run) run ;;
  keyboard)
    state=$("$kp" toggle 2>/dev/null) || {
      notify "keybars Pro isn't running"
      exit 0
    }
    notify "keyboard lights $state"
    ;;
  toggle)
    mkdir -p "$state_dir"
    if [[ -f "$disabled" ]]; then
      rm -f "$disabled"
      notify "agent lights on"
    else
      touch "$disabled"
      notify "agent lights off"
    fi
    ;;
  *)
    echo "usage: watch start|stop|run|toggle|keyboard" >&2
    exit 1
    ;;
esac
